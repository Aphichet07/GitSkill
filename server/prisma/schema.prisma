// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                Int       @id @default(autoincrement())
  email             String    @unique
  password          String?
  googleId          String?   @unique
  githubId          String?   @unique
  githubAccessToken String?
  name              String?
  isVerified        Boolean   @default(false)
  activationToken   String?   @unique
  tokenExpiresAt    DateTime?

  skills   UserSkill[]
  projects UserProject[]
  badges           UserBadge[]

  createdAt DateTime @default(now())
}

model UserSkill {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  language    String
  points      Int      @default(0)
  lastUpdated DateTime @default(now()) @updatedAt @map("last_updated")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@map("user_skills")
}

model UserProject {
  id             Int            @id @default(autoincrement())
  userId         Int            @map("user_id")
  mongoProjectId String         @map("mongo_project_id")
  projectName    String         @map("project_name")
  createdAt      DateTime       @default(now()) @map("created_at")
  projectSkills  ProjectSkill[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectAnalysis Project_analysis?
  badges           ProjectBadge[]
  @@map("user_projects")
}

model ProjectSkill {
  id            Int    @id @default(autoincrement())
  userProjectId Int    @map("user_project_id")
  language      String
  points        Int

  project UserProject @relation(fields: [userProjectId], references: [id], onDelete: Cascade)

  @@map("project_skills")
}

model Project_analysis {
  id                 Int           @id @default(autoincrement())
  user_project_id    Int           @unique
  
  grade              String        @db.VarChar(2) // S, A, B, C, F
  final_score        Int
  
  doc_score          Int
  arch_score         Int
  test_ci_score      Int
  clean_code_score   Int
  efficiency_score   Int
  security_score     Int
  habit_score        Int

  detailed_stats     Json?
  
  insight            String?       @db.Text
  
  analyzed_at        DateTime      @default(now()) @db.Timestamp(6)

  project            UserProject  @relation(fields: [user_project_id], references: [id], onDelete: Cascade)
}

model Badge {
  id          Int      @id @default(autoincrement())
  name        String   @unique // เช่น "Documentarian", "React Ninja"
  description String   // คำอธิบายเกณฑ์การได้ Badge
  iconUrl     String?  // URL ของรูปภาพห
  category    String   // จัดกลุ่ม Badge เช่น "TECH_MASTERY", "BEST_PRACTICE", "ACTIVITY"
  tier        String?  // ระดับของ Badge (เช่น Gold, Silver, Bronze)
  createdAt   DateTime @default(now())

  // Relations
  userBadges    UserBadge[]
  projectBadges ProjectBadge[]

  @@map("badges") 
}

model UserBadge {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  badgeId   Int      @map("badge_id")
  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@map("user_badges")
}

model ProjectBadge {
  id              Int      @id @default(autoincrement())
  userProjectId   Int      @map("user_project_id")
  badgeId         Int      @map("badge_id")
  earnedAt        DateTime @default(now())

  project         UserProject @relation(fields: [userProjectId], references: [id], onDelete: Cascade)
  badge           Badge       @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userProjectId, badgeId])
  @@map("project_badges")
}